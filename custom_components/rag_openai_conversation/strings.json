  "options": {
    "step": {
      "init": {
        "data": {
          "prompt": "System Prompt",
          "enable_rag": "Enable RAG",
          "chat_model": "[%key:common::generic::model%]",
          "embedding_model": "Embedding Model",
          "max_tokens": "Maximum tokens to return in response",
