            "data": {
              "title": "Title",
              "domain": "Entity domain",
              "question": "Example question",
              "tool_call": "Tool to call",
              "tool_call_args": "Tool arguments (as a JSON dictionary)",
              "answer": "Answer"
            }
          },
          "reconfigure": {
            "title": "Edit Example",
            "description": "Modify existing in-context learning example",
            "data": {
              "title": "Title",
              "domain": "Entity domain",
              "question": "Example question",
              "tool_call": "Tool to call",
              "tool_call_args": "Tool arguments (as a JSON dictionary)",
              "answer": "Answer"
            }
          }
        }
      }
