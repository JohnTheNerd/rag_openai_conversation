            "prompt": "LLM prompt to use"
          }
        },
        "reconfigure": {
          "title": "Edit Document",
          "description": "Modify existing RAG document",
          "data": {
            "title": "Title",
            "description": "Description (can be a template)",
            "prompt": "LLM prompt to use"
          }
        }
      },
      "error": {},
      "abort": {}
    },
    "example": {
        "title": "Few-shot Example",
        "step": {
