  "selector": {
    "reasoning_effort": {
      "options": {
        "low": "Low",
        "medium": "Medium",
        "high": "High"
      }
    }
  },
  "services": {
    "generate_image": {
      "name": "Generate image",
      "description": "Turns a prompt into an image",
